# Canonical public frontend origin. This is not the Base44 API origin.
# Production must use this exact apex domain; previews retain it only as canonical identity.
APP_BASE_URL=https://vensaos.com

# Keep external delivery disabled until a separate real-email authorization.
NOTIFICATION_INTEGRATION_ENABLED=false

# Optional local Base44 development server. Leave absent from production and preview builds;
# the production SDK continues to connect directly to the hosted Base44 backend.
VITE_BASE44_APP_BASE_URL=http://localhost:4400
