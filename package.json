{
  "name": "vensaos",
  "description": "Feedback intelligence for product teams",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "brand:check": "npm run build --silent && node scripts/brand-check.mjs",
    "demo:seed": "npx base44 exec < scripts/demo/seed-demo.ts",
    "demo:reset": "npx base44 exec < scripts/demo/reset-demo.ts",
    "demo:verify": "npx base44 exec < scripts/demo/verify-demo.ts",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.3",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
