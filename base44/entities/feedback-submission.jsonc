{
  "name": "FeedbackSubmission",
  "description": "One reporter's original submission. Created only by the submit-feedback backend function (service role). Original text is preserved verbatim.",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Project this submission belongs to (Base44 record id)"
    },
    "owner_id": {
      "type": "string",
      "description": "Owner email, copied from the project's created_by. Enables owner-scoped RLS without cross-entity joins."
    },
    "submission_key": {
      "type": "string",
      "description": "Client-generated UUID used for idempotency within a project"
    },
    "type": {
      "type": "string",
      "enum": ["bug", "feature", "general"],
      "description": "Feedback type"
    },
    "description": {
      "type": "string",
      "description": "The reporter's original text — never overwritten"
    },
    "expected_behavior": {
      "type": "string",
      "description": "What the reporter expected (bugs only)"
    },
    "page_url": {
      "type": "string",
      "description": "Optional page the reporter was on"
    },
    "reproduction_steps": { "type": "string" },
    "reporter_email_hash": { "type": "string" },
    "browser_name": { "type": "string" },
    "browser_version": { "type": "string" },
    "operating_system": { "type": "string" },
    "device_type": { "type": "string" },
    "screen_width": { "type": "integer", "minimum": 0 },
    "screen_height": { "type": "integer", "minimum": 0 },
    "viewport_width": { "type": "integer", "minimum": 0 },
    "viewport_height": { "type": "integer", "minimum": 0 },
    "context_included": {
      "type": "boolean",
      "description": "Whether the reporter reviewed and retained optional browser/device context"
    },
    "reporter_email": {
      "type": "string",
      "format": "email",
      "description": "Optional reporter email. Never returned through the public tracking response."
    },
    "reporter_email_updates_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Reporter consent for workflow email. Email presence alone is not consent."
    },
    "reporter_email_consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "processing_status": {
      "type": "string",
      "enum": ["pending", "processing", "completed", "failed"],
      "default": "pending",
      "description": "Asynchronous intelligence processing state"
    },
    "processing_error": { "type": "string" },
    "processing_attempts": { "type": "integer", "minimum": 0 },
    "processing_started_at": { "type": "string", "format": "date-time" },
    "processing_completed_at": { "type": "string", "format": "date-time" },
    "processing_version": { "type": "string" },
    "ai_summary": { "type": "string" },
    "ai_category": {
      "type": "string",
      "enum": ["ui_ux", "functionality", "performance", "authentication", "data", "content", "other"]
    },
    "ai_product_area": { "type": "string" },
    "ai_severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "ai_severity_reasons": { "type": "array", "items": { "type": "string" } },
    "ai_keywords": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "ai_reproducibility": { "type": "string", "enum": ["confirmed", "likely", "unknown"] },
    "ai_core_workflow_blocked": { "type": "boolean" },
    "ai_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ai_analysis_mode": {
      "type": "string",
      "enum": ["ai", "deterministic_fallback", "owner_corrected"],
      "description": "Whether classification used Base44 AI, the free deterministic fallback, or an owner correction"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Function-set creation timestamp"
    }
  },
  "required": ["project_id", "owner_id", "type", "description"],
  // Only the service role creates/updates submissions. The owner may read their
  // own (owner_id match). Public users can never read or list submissions.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.owner_id": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
