{
  "name": "ReporterAccess",
  "description": "Private tracking grant for a submission. Only the SHA-256 hash of the token is stored. Accessed exclusively through backend functions (service role) — never read by the owner or public directly.",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Project this grant belongs to"
    },
    "owner_id": {
      "type": "string",
      "description": "Owner email, copied from the project"
    },
    "submission_id": {
      "type": "string",
      "description": "The FeedbackSubmission this token tracks"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash (hex) of the raw tracking token. The raw token is returned to the reporter only once and never stored."
    },
    "purpose": {
      "type": "string",
      "enum": ["initial_tracking", "email_notification"],
      "default": "initial_tracking"
    },
    "notification_delivery_id": {
      "type": "string",
      "description": "Delivery that created this email tracking grant, if applicable"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Token expiry (default 30 days from creation)"
    },
    "email_updates_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the reporter opted into email updates"
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the tracking page was opened with this token"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when an unused email grant is revoked after failed delivery"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Function-set creation timestamp"
    }
  },
  "required": ["project_id", "submission_id", "token_hash"],
  // Never client-readable. All access is via backend functions using the service
  // role. No owner or public read path exists.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
